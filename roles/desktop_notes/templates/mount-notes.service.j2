[Unit]
Description=Mount WebDAV Notes Service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=bash -c 'for i in {1..15}; do mountpoint -q {{ expanded_path }} && exit 0; mount {{ expanded_path }} && exit 0; sleep 1; done; exit 1'
# The sleep hook may already have unmounted it directly.
ExecStop=-umount {{ expanded_path }}
RemainAfterExit=true

[Install]
WantedBy=default.target
